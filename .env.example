# Base de datos.
# Desarrollo con PostgreSQL local (levantalo con: docker compose up -d):
DATABASE_URL=postgresql+asyncpg://ommadawn:ommadawn@localhost:5432/ommadawn
# Alternativa rapida sin instalar nada (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./ommadawn.db

# Clave para firmar los JWT. OBLIGATORIO cambiarla.
# Generar una con: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-random-secret-key

# Parametros de los tokens
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Almacenamiento de imagenes (portadas, contraportadas...).
# Desarrollo: disco local, servido por la propia API en /media.
STORAGE_BACKEND=local
MEDIA_ROOT=./media
MEDIA_BASE_URL=http://localhost:8000/media
# Produccion seria (pendiente de implementar):
# STORAGE_BACKEND=gcs

# Envio de correo (verificacion de email). Desarrollo: escribe el correo en
# el log en vez de enviarlo de verdad.
EMAIL_BACKEND=console
# Produccion seria (pendiente de implementar):
# EMAIL_BACKEND=smtp

# Login con Google. Web Client ID del proyecto en Google Cloud Console: es la
# audiencia (`aud`) que debe llevar el ID token que envia el cliente (iOS y, en
# el futuro, Android usan el MISMO Web Client ID como `serverClientID`/audiencia).
# No es un secreto (va incrustado en apps publicas), pero se configura por .env
# igual que el resto: cambiar de proyecto de Google no debe tocar codigo.
GOOGLE_WEB_CLIENT_ID=681872954393-j7sc19l0opgbhap8c698kj1f3iok8m00.apps.googleusercontent.com
